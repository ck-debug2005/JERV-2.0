# API (Express + SQLite)
PORT=3001
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_EMAIL=admin@modernshop.local
ADMIN_PASSWORD=AdminChangeMe123!

# Seeded demo customer (after first API start): demo@modernshop.local / DemoUser123!
# To re-run the seed, stop the server and delete server/data/modern_shop.sqlite

# Frontend (Vite) — leave empty to proxy /api to Node (port 3001).
# For the PHP + MySQL API: http://localhost:8080
# VITE_API_URL=

# Google OAuth (optional — for “Continue with Google”)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
